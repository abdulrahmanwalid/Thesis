# KSHV SOX (3POV) + DNA + 2 Mg2+ + AD51 docked at the catalytic Mg2+ site
# Same file is used for the neutral and negative Mg-site poses: swap the mol2/frcmod/pdb names
source leaprc.protein.ff14SB
source leaprc.DNA.OL15
source leaprc.gaff2
source leaprc.water.tip3p

LIG = loadmol2 AD51.mol2           # GAFF2 / AM1-BCC, residue name LIG
loadamberparams AD51.frcmod        # from parmchk2

sys = loadpdb sox_ad51_mgsite_complex.pdb # CHECK: protein + DNA + Mg + LIG docked pose

check sys
charge sys

solvatebox sys TIP3PBOX 12.0       # CHECK
addionsrand sys Na+ NA_COUNT Cl- CL_COUNT

saveamberparm sys complex.prmtop complex.inpcrd
savepdb sys complex_solv.pdb
quit
